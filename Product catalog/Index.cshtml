
@model IEnumerable<ProductCatalog.Models.Product>

<!DOCTYPE html>

<html>
<head>
    <meta charset="utf-8" />
    <title>Product Catalog</title>

    <style>
        body {
            font-family: Arial;
            background-color: #f2f2f2;
            margin: 40px;
        }

        .container {
            width: 90%;
            margin: auto;
        }

        h1 {
            text-align: center;
            color: #333;
        }

        .add-button {
            display: inline-block;
            padding: 10px 18px;
            background-color: green;
            color: white;
            text-decoration: none;
            margin-bottom: 20px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            background-color: white;
        }

        th {
            background-color: #333;
            color: white;
            padding: 12px;
        }

        td {
            padding: 12px;
            border: 1px solid #ccc;
            text-align: center;
        }

        .details {
            color: blue;
            text-decoration: none;
        }
    </style>
</head>

<body>

    <div class="container">

        <h1>Product Catalog</h1>

        <a class="add-button"
           href="@Url.Action("Create", "Product")">
            Add Product
        </a>

        <table>

            <tr>
                <th>Product ID</th>
                <th>Product Name</th>
                <th>Category</th>
                <th>Price</th>
                <th>Description</th>
                <th>Action</th>
            </tr>

            @foreach (var product in Model)
            {
                <tr>
                    <td>@product.ProductId</td>

                    <td>@product.ProductName</td>

                    <td>@product.Category</td>

                    <td>₹ @product.Price</td>

                    <td>@product.Description</td>

                    <td>
                        @Html.ActionLink(
                            "View Details",
                            "Details",
                            "Product",
                            new { id = product.ProductId },
                            new { @class = "details" }
                        )
                    </td>
                </tr>
            }

        </table>

    </div>

</body>
</html>

